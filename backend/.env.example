# Django EduMatrix Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# =============================================================================
# REQUIRED VARIABLES (Production)
# =============================================================================
# These variables MUST be set in production environments

# Django Secret Key
# Used for cryptographic signing (sessions, cookies, CSRF tokens, etc.)
# Generate a new secret key for production using:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# SECURITY: Never use the default development key in production
DJANGO_SECRET_KEY=your-secret-key-here

# Supabase Database Configuration
# Database username for Supabase PostgreSQL connection
# Example: postgres.abcdefghijklmnopqrst
SUPABASE_DB_USER=your-supabase-db-user

# Database password for Supabase PostgreSQL connection
# SECURITY: Keep this value secret and never commit to version control
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Database host for Supabase PostgreSQL connection
# Example: db.abcdefghijklmnopqrst.supabase.co
SUPABASE_DB_HOST=your-supabase-db-host

# =============================================================================
# OPTIONAL VARIABLES (Development & Production)
# =============================================================================
# These variables have sensible defaults but can be customized

# Django Debug Mode
# Set to True for development, False for production
# Default: False (secure default for production)
# SECURITY: Never enable debug mode in production
DJANGO_DEBUG=False

# Test Database Backend
# Runtime always uses Supabase. Test runs may use sqlite for isolation unless
# you explicitly switch them to Supabase.
DJANGO_TEST_DATABASE_BACKEND=sqlite

# Optional. Defaults to in-memory sqlite when tests use sqlite.
DJANGO_TEST_SQLITE_NAME=:memory:

# Optional admin bootstrap helper for a fresh Supabase database.
EDUMATRIX_ADMIN_USERNAME=
EDUMATRIX_ADMIN_EMAIL=
EDUMATRIX_ADMIN_PASSWORD=
EDUMATRIX_ADMIN_FIRST_NAME=
EDUMATRIX_ADMIN_LAST_NAME=

# Allowed Hosts
# Comma-separated list of hostnames that Django will serve
# Default: localhost,127.0.0.1 (suitable for local development)
# Production example: edumatrix.tech,www.edumatrix.tech
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,edumatrix.tech,www.edumatrix.tech

# CSRF trusted origins
# Production example: https://edumatrix.tech,https://www.edumatrix.tech
DJANGO_CSRF_TRUSTED_ORIGINS=https://edumatrix.tech,https://www.edumatrix.tech

# Secure Cookies
# Enable secure flag on session and CSRF cookies (requires HTTPS)
# Default: True in production (DEBUG=False), False in development (DEBUG=True)
# Set to True in production to ensure cookies are only sent over HTTPS
# Set to False in local development without HTTPS
DJANGO_SECURE_COOKIES=True

# HTTPS / HSTS
# Defaults are production-safe when DJANGO_DEBUG=False.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# X-Frame-Options Header
# Controls whether the site can be embedded in iframes
# Default: DENY (prevents clickjacking attacks)
# Options: DENY, SAMEORIGIN, ALLOW-FROM uri
# SECURITY: Use DENY or SAMEORIGIN in production
DJANGO_X_FRAME_OPTIONS=DENY

# CSRF tunnel bypass
# Leave False. Localtunnel/ngrok/Cloudflare hosts are supported through trusted origins.
DJANGO_DISABLE_CSRF_FOR_TUNNELS=False

# Supabase Database Name
# Name of the PostgreSQL database
# Default: postgres (standard Supabase default)
SUPABASE_DB_NAME=postgres

# Supabase Database Port
# Port for PostgreSQL connection
# Default: 6543 (Supabase connection pooler port)
# Note: Direct connection port is typically 5432
SUPABASE_DB_PORT=6543

# Supabase Auth Configuration
# Required for teacher/student email OTP verification.
# SUPABASE_URL can be inferred when SUPABASE_DB_USER is postgres.<project-ref>,
# but setting it explicitly is recommended in production.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_AUTH_ENABLED=True
SUPABASE_OTP_TTL_MINUTES=60

# Transactional Email Configuration
# Resend is the recommended production email provider for welcome/reset emails.
# Use onboarding@resend.dev only for testing with your own inbox. Before public
# launch, verify your own domain in Resend and update DJANGO_DEFAULT_FROM_EMAIL.
RESEND_API_KEY=your-resend-api-key
RESEND_API_URL=https://api.resend.com/emails
DJANGO_EMAIL_BACKEND=accounts.email_backend.ResendEmailBackend
DJANGO_DEFAULT_FROM_EMAIL=EduMatrix <support@edumatrix.tech>
DJANGO_PUBLIC_SITE_URL=https://edumatrix.tech

# Optional SMTP fallback if you explicitly switch DJANGO_EMAIL_BACKEND.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False

# =============================================================================
# THIRD-PARTY API KEYS (Optional)
# =============================================================================
# These API keys are optional and only required if using specific AI features

# Sarvam AI API Key
# Required for Sarvam AI features (if used in the application)
# Leave empty if not using Sarvam AI services
# Example: sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SARVAM_API_KEY=

# Google AI API Key
# Required for Google AI/Gemini features (if used in the application)
# Leave empty if not using Google AI services
# Example: AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_AI_API_KEY=

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 
# Local Development Setup:
# 1. Copy this file to .env in the same directory
# 2. Fill in your Supabase database credentials (required)
# 3. Set DJANGO_DEBUG=True for development
# 4. Set DJANGO_SECURE_COOKIES=False for local development without HTTPS
# 5. API keys can be left empty if not testing AI features
#
# Production Deployment:
# 1. Generate a strong SECRET_KEY (never use the development default)
# 2. Set DJANGO_DEBUG=False
# 3. Configure DJANGO_ALLOWED_HOSTS with your actual domain(s)
# 4. Set DJANGO_SECURE_COOKIES=True (requires HTTPS)
# 5. Ensure all required database credentials are set
# 6. Set API keys if using AI features
# 7. Use environment variables or secrets management (not .env file)
#
# Tunnel Compatibility:
# The application is configured to work with localtunnel, ngrok, and cloudflare
# tunnels. CSRF_TRUSTED_ORIGINS is pre-configured in settings.py to allow these
# tunnel services. No additional environment variables needed for tunnel support.
#
# Security Best Practices:
# - Never commit .env file to version control (add to .gitignore)
# - Use different credentials for development and production
# - Rotate secrets regularly, especially after team member changes
# - Use secrets management services in production (AWS Secrets Manager, etc.)
# - Limit database user permissions to only what's needed
# - Enable database connection encryption (sslmode=require is configured)
